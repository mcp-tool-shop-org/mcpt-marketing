{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-tool-shop.github.io/mcpt-marketing/schema/v1/marketing.schema.json",
  "schemaVersion": "1",
  "title": "MarketIR Schema",
  "description": "Deterministic marketing intermediate representation for MCP Tool Shop tools.\n\nConventions for forward compatibility:\n  - Field-level deprecation: fields annotated `deprecated: true` (JSON Schema 2020-12 keyword) are scheduled for removal in the next MAJOR schemaVersion. Producers SHOULD stop writing them; consumers SHOULD ignore them. The convention is: rename → keep the old field for one minor cycle marked `deprecated: true` with `description: \"Renamed to X. Will be removed in v2.\"` → remove in the next major. See `$defs._deprecation` for a template.\n  - ID stability: every IDed entity (tool, audience, claim, evidence, message, campaign) supports an optional `aliases[]` of previous IDs. When an entity is renamed, the old ID moves into `aliases[]`. Consumers that resolve a missing ID MAY fall back to scanning `aliases[]` to build an alias→canonical resolution map. New aliases are append-only; never repurpose.\n  - Extension fields: every top-level entity object permits properties prefixed `x-` (the W3C/OpenAPI extension convention) for vendor/consumer extensions and forward-compatible experimentation. These are intentionally not validated by the schema; the strict `additionalProperties: false` policy still rejects unknown non-prefixed properties.\n  - Enum extensibility: `messageChannel` and `pressContactMethod` use a `oneOf [closed-enum, x-prefixed pattern]` shape, so producers MAY ship `x-bluesky` / `x-mastodon` / `x-podcast` etc. without a schema bump. Consumers SHOULD warn-not-fail on x-prefixed values they do not recognize.\n  - Schema version: this schema document carries a top-level `schemaVersion` of its own; the `$id` is version-aware (`/schema/v1/...`). Artifact `schemaVersion` fields assert conformance to that schema major version.\n  - Defaults: a few fields declare `default` values. Consumers SHOULD run AJV with `useDefaults: true` to populate them. Defaults do not relax `required`.",

  "$defs": {
    "_deprecation": {
      "$comment": "Template / convention reference (not referenced by any field). When deprecating a field, copy this pattern: add `\"deprecated\": true` and update the `description` to start with `\"Renamed to X. Will be removed in v2.\"`. The validator may emit a warning when data populates a deprecated field. This block is intentionally inert — its purpose is to document the convention in one place.",
      "deprecated": true,
      "description": "Renamed to <new-field>. Will be removed in v2."
    },

    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "description": "A required string with at least one character. Use for freeform fields where empty content is meaningless."
    },

    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semver version of the schema this document conforms to."
    },

    "toolId": {
      "type": "string",
      "pattern": "^tool\\.[a-z0-9-]+$"
    },
    "audienceId": {
      "type": "string",
      "pattern": "^aud\\.[a-z0-9-]+$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^claim\\.[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^ev\\.[a-z0-9-]+\\.[a-z0-9-]+\\.v\\d+$"
    },
    "messageId": {
      "type": "string",
      "pattern": "^msg\\.[a-z0-9-]+\\.[a-z0-9-]+$"
    },
    "campaignId": {
      "type": "string",
      "pattern": "^camp\\.[a-z0-9-]+\\.[a-z0-9-]+$"
    },

    "lastModified": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 datetime when this artifact's content was last meaningfully changed. Optional; populated by the lock generator when it regenerates. Consumers MAY use this for conditional fetches and cache invalidation."
    },

    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 hex digest of this artifact's serialized content (mirrors the lockfile entry). Optional; populated by the lock generator. Consumers MAY use this for cache validation without joining against the lockfile."
    },

    "claimStatus": {
      "type": "string",
      "default": "aspirational",
      "enum": ["proven", "aspirational", "deprecated"],
      "description": "Lifecycle state of a claim. Default `aspirational` is the safe default — a claim must explicitly graduate to `proven` (with evidence) or be retired to `deprecated`."
    },
    "evidenceType": {
      "type": "string",
      "default": "report",
      "enum": ["image", "text", "report", "video", "link"],
      "description": "Closed taxonomy. Admission criteria for new values: must be a structurally distinct evidence shape (not a sub-genre of an existing type). `interactive` and `benchmark` are anticipated v2 candidates."
    },
    "messageTone": {
      "type": "string",
      "default": "pragmatic",
      "enum": ["technical", "pragmatic", "playful", "executive"],
      "description": "Closed taxonomy. Admission criteria for new values: must capture a distinct register that meaningfully changes drafting, not a topic. `technical-deep` vs `technical-intro` are anticipated v2 candidates."
    },
    "messageChannel": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["web", "readme", "hn", "x", "linkedin", "newsletter", "presskit"],
          "description": "Known/canonical message channels."
        },
        {
          "type": "string",
          "pattern": "^x-[a-z][a-z0-9-]*$",
          "description": "Experimental / forward-compat channel (e.g. `x-bluesky`, `x-mastodon`, `x-podcast`, `x-discord`, `x-reddit`). Producers MAY ship x-prefixed values without a schema bump. Consumers SHOULD warn-not-fail on unrecognized x-channels."
        }
      ],
      "description": "Distribution channel for a message. Closed enum + x-prefixed extension pattern for forward compatibility."
    },

    "pressContactMethod": {
      "oneOf": [
        {
          "type": "string",
          "enum": ["email", "x-dm", "linkedin", "github-issue", "form"],
          "description": "Known/canonical contact methods."
        },
        {
          "type": "string",
          "pattern": "^x-[a-z][a-z0-9-]*$",
          "description": "Experimental / forward-compat contact method (e.g. `x-bluesky-dm`, `x-mastodon-dm`, `x-signal`, `x-matrix`). Producers MAY ship x-prefixed values without a schema bump."
        }
      ],
      "description": "Press/partner contact method. Closed enum + x-prefixed extension pattern for forward compatibility."
    },

    "pressContact": {
      "type": "object",
      "required": ["method", "value"],
      "properties": {
        "method": { "$ref": "#/$defs/pressContactMethod" },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "Contact value (URL, email, handle). Format depends on method."
        },
        "label": {
          "type": "string",
          "description": "Human-readable label for this contact method."
        },
        "notes": { "type": "string" }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "email" } }, "required": ["method"] },
          "then": { "properties": { "value": { "type": "string", "format": "email" } } }
        },
        {
          "if": { "properties": { "method": { "const": "x-dm" } }, "required": ["method"] },
          "then": { "properties": { "value": { "type": "string", "pattern": "^@[a-zA-Z0-9_]+$" } } }
        },
        {
          "if": { "properties": { "method": { "const": "linkedin" } }, "required": ["method"] },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^https?://(www\\.)?linkedin\\.com/.+"
              }
            }
          }
        },
        {
          "if": { "properties": { "method": { "const": "github-issue" } }, "required": ["method"] },
          "then": { "properties": { "value": { "type": "string", "format": "uri" } } }
        },
        {
          "if": { "properties": { "method": { "const": "form" } }, "required": ["method"] },
          "then": { "properties": { "value": { "type": "string", "format": "uri" } } }
        }
      ],
      "examples": [
        {
          "method": "email",
          "value": "press@example.com",
          "label": "Press inquiries"
        },
        {
          "method": "github-issue",
          "value": "https://github.com/owner/repo/issues",
          "label": "Open an issue"
        }
      ]
    },

    "pressQuote": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Approved quote text."
        },
        "attribution": {
          "type": "string",
          "description": "Who said this."
        },
        "role": {
          "type": "string",
          "description": "Role or title of the person quoted."
        },
        "claimRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/claimId" },
          "uniqueItems": true,
          "description": "Claims this quote supports."
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "examples": [
        {
          "text": "We replaced 200 lines of brittle CI scripts with one zip-meta-map invocation.",
          "attribution": "Jane Doe",
          "role": "Staff Engineer, ExampleCo",
          "claimRefs": ["claim.zip-meta-map.ci-gating"]
        }
      ]
    },

    "pressComparable": {
      "type": "object",
      "required": ["target", "distinction"],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "What this tool is similar to."
        },
        "distinction": {
          "type": "string",
          "minLength": 1,
          "description": "How it differs (honest, not dismissive)."
        },
        "notes": { "type": "string" }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },

    "pressPartnerOffer": {
      "type": "object",
      "required": ["type", "description"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["demo", "co-announcement", "integration", "early-access", "case-study"]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "What you are offering."
        },
        "constraints": {
          "type": "string",
          "description": "Any limitations or conditions."
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },

    "targetingOrgType": {
      "type": "string",
      "enum": ["org", "user"]
    },

    "targetingSeedRepo": {
      "type": "object",
      "required": ["owner", "repo"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "GitHub owner (org or user)."
        },
        "repo": {
          "type": "string",
          "minLength": 1,
          "description": "GitHub repo name."
        },
        "notes": { "type": "string" }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "examples": [
        {
          "owner": "Aider-AI",
          "repo": "aider",
          "notes": "Canonical aider repo"
        }
      ]
    },

    "targetingBlock": {
      "type": "object",
      "description": "Optional targeting spec for partner/integrator discovery. Drives the target list generator.\n\nConsumer behavior on missing fields:\n  - keywords/topics: required for any target generation; if BOTH absent, generator MUST emit zero targets and warn.\n  - languages: if absent, generator does NOT filter by language (matches all).\n  - orgTypes: if absent, generator includes both 'org' and 'user' results.\n  - exclusions: if absent, generator applies no exclusions.\n  - seedRepos: if absent, generator skips similarity expansion.",
      "properties": {
        "keywords": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Search keywords for GitHub readme/description matching."
        },
        "topics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true,
          "description": "GitHub repo topics to search for."
        },
        "languages": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "Programming languages to filter by."
        },
        "orgTypes": {
          "type": "array",
          "items": { "$ref": "#/$defs/targetingOrgType" },
          "uniqueItems": true,
          "description": "Filter by GitHub owner type."
        },
        "exclusions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true,
          "description": "GitHub owners or repos to exclude from results."
        },
        "seedRepos": {
          "type": "array",
          "items": { "$ref": "#/$defs/targetingSeedRepo" },
          "uniqueItems": true,
          "description": "Known repos to use for similarity expansion."
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },

    "pressBlock": {
      "type": "object",
      "description": "Optional press/partner data for a tool. Enables press pages, outreach packs, and partner bundles.",
      "properties": {
        "boilerplate": {
          "type": "object",
          "properties": {
            "projectDescription": {
              "type": "string",
              "minLength": 1,
              "description": "Extended project description for press use."
            },
            "founderBio": {
              "type": "string",
              "minLength": 1,
              "description": "Team or founder bio."
            },
            "preferredNouns": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true,
              "description": "Preferred terms for the tool (e.g. tool, CLI, indexer)."
            },
            "forbiddenPhrases": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true,
              "description": "Phrases to never use in press/marketing (e.g. AI-powered, revolutionary). The validator unions per-tool lists with any project-wide list (`marketing.index.json.projectForbiddenPhrases`) and scans all prose against the union."
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        },
        "contacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/pressContact" },
          "uniqueItems": true
        },
        "quotes": {
          "type": "array",
          "items": { "$ref": "#/$defs/pressQuote" },
          "maxItems": 6,
          "uniqueItems": true
        },
        "comparables": {
          "type": "array",
          "items": { "$ref": "#/$defs/pressComparable" },
          "uniqueItems": true
        },
        "partnerOffers": {
          "type": "array",
          "items": { "$ref": "#/$defs/pressPartnerOffer" },
          "uniqueItems": true
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },

    "constraints": {
      "type": "object",
      "description": "Soft advisory constraints for a channel or context.",
      "properties": {
        "maxChars": {
          "type": "integer",
          "minimum": 1
        },
        "maxSentences": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },

    "graduation": {
      "type": "object",
      "description": "Optional graduation tracking for aspirational claims. Recommended when status='aspirational' and the team commits to graduating. Omit for exploratory claims with no committed timeline. The validator MAY warn-or-fail when status='aspirational' and graduation.targetDate is in the past.",
      "properties": {
        "targetDate": {
          "type": "string",
          "format": "date",
          "description": "YYYY-MM-DD by which proven evidence is expected."
        },
        "blockedBy": {
          "type": "string",
          "minLength": 1,
          "description": "Free-form blocker (e.g. 'Upstream zip-meta-map repo not public', 'benchmark-not-yet-built'). Consumers MAY group claims by this for triage."
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "description": "Person or team responsible for graduating this claim."
        },
        "criteria": {
          "type": "string",
          "minLength": 1,
          "description": "What evidence would graduate this claim to proven. One sentence."
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },

    "claim": {
      "type": "object",
      "required": ["id", "status", "statement"],
      "properties": {
        "id": { "$ref": "#/$defs/claimId" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/claimId" },
          "uniqueItems": true,
          "description": "Previous IDs by which this claim may have been known. Append-only; never repurpose. Consumers that resolve a missing ID MAY fall back to scanning aliases."
        },
        "status": { "$ref": "#/$defs/claimStatus" },
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "A falsifiable claim about the tool."
        },
        "evidenceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceId" },
          "uniqueItems": true,
          "description": "Required when status is proven."
        },
        "graduation": { "$ref": "#/$defs/graduation" },
        "notes": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "if": {
        "properties": { "status": { "const": "proven" } }
      },
      "then": {
        "required": ["evidenceRefs"],
        "properties": {
          "evidenceRefs": { "type": "array", "minItems": 1 }
        }
      },
      "examples": [
        {
          "id": "claim.example.deterministic-output",
          "status": "proven",
          "statement": "Given the same repository state, the tool produces byte-identical output.",
          "evidenceRefs": ["ev.example.deterministic-test.v1"]
        },
        {
          "id": "claim.example.sub-second-builds",
          "status": "aspirational",
          "statement": "Typical repo builds complete in under one second.",
          "graduation": {
            "targetDate": "2026-09-01",
            "blockedBy": "benchmark harness not yet built",
            "owner": "perf-team",
            "criteria": "p50 build time across the dogfood corpus is under 1.0s"
          }
        }
      ]
    },

    "antiClaim": {
      "type": "object",
      "required": ["statement"],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "description": "What the tool does NOT do. Prevents misuse and builds trust."
        },
        "notes": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false
    },

    "message": {
      "type": "object",
      "required": ["id", "channel", "tone", "text", "claimRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/messageId" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/messageId" },
          "uniqueItems": true,
          "description": "Previous IDs by which this message may have been known. Append-only; never repurpose."
        },
        "channel": { "$ref": "#/$defs/messageChannel" },
        "tone": { "$ref": "#/$defs/messageTone" },
        "text": {
          "type": "string",
          "minLength": 1,
          "description": "The message content."
        },
        "claimRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/claimId" },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Every message must trace to at least one claim."
        },
        "constraints": { "$ref": "#/$defs/constraints" },
        "notes": {
          "type": "string"
        }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "examples": [
        {
          "id": "msg.example.web-blurb",
          "channel": "web",
          "tone": "pragmatic",
          "text": "Make repos and ZIPs self-describing for LLMs with CI-grade diffs.",
          "claimRefs": ["claim.example.deterministic-output"],
          "constraints": { "maxChars": 280 }
        }
      ]
    },

    "tool": {
      "type": "object",
      "required": [
        "schemaVersion",
        "id",
        "name",
        "positioning",
        "audienceRefs",
        "claims",
        "antiClaims",
        "messages"
      ],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "id": { "$ref": "#/$defs/toolId" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/toolId" },
          "uniqueItems": true,
          "description": "Previous IDs by which this tool may have been known. Append-only; never repurpose."
        },
        "lastModified": { "$ref": "#/$defs/lastModified" },
        "contentHash": { "$ref": "#/$defs/contentHash" },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "positioning": {
          "type": "object",
          "required": ["oneLiner", "valueProps"],
          "properties": {
            "oneLiner": {
              "type": "string",
              "minLength": 1,
              "description": "One sentence that explains the tool."
            },
            "valueProps": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "minItems": 1,
              "uniqueItems": true,
              "description": "Key value propositions."
            }
          },
          "patternProperties": {
            "^x-": {}
          },
          "additionalProperties": false
        },
        "audienceRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/audienceId" },
          "minItems": 1,
          "uniqueItems": true
        },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claim" },
          "minItems": 1,
          "uniqueItems": true
        },
        "antiClaims": {
          "type": "array",
          "items": { "$ref": "#/$defs/antiClaim" },
          "minItems": 1,
          "uniqueItems": true
        },
        "messages": {
          "type": "array",
          "items": { "$ref": "#/$defs/message" },
          "minItems": 1,
          "uniqueItems": true
        },
        "press": { "$ref": "#/$defs/pressBlock" },
        "targeting": { "$ref": "#/$defs/targetingBlock" }
      },
      "patternProperties": {
        "^x-": {}
      },
      "additionalProperties": false,
      "examples": [
        {
          "schemaVersion": "1.0.0",
          "id": "tool.example",
          "name": "example",
          "positioning": {
            "oneLiner": "One sentence about the tool.",
            "valueProps": ["Deterministic", "CI-friendly"]
          },
          "audienceRefs": ["aud.example-audience"],
          "claims": [
            {
              "id": "claim.example.deterministic-output",
              "status": "proven",
              "statement": "Same input produces byte-identical output.",
              "evidenceRefs": ["ev.example.test.v1"]
            }
          ],
          "antiClaims": [{ "statement": "Does not perform runtime vulnerability scanning." }],
          "messages": [
            {
              "id": "msg.example.web",
              "channel": "web",
              "tone": "pragmatic",
              "text": "One pragmatic sentence about the tool.",
              "claimRefs": ["claim.example.deterministic-output"]
            }
          ]
        }
      ]
    },

    "audience": {
      "type": "object",
      "required": ["schemaVersion", "id", "name", "description", "painPoints"],
      "properties": {
        "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
        "id": { "$ref": "#/$defs/audienceId" },
        "aliases": {
          "type": "array",
          "items": { "$ref": "#/$defs/audienceId" },
          "uniqueItems": true,
          "description": "Previous IDs by which this audience may have been known. Append-only; never repurpose."
        },
        "lastModified": { "$ref": "#/$defs/lastModified" },
        "contentHash": { "$ref": "#/$defs/contentHash" },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "painPoints": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "patternProperties": {
        "^x-": {}
      },
